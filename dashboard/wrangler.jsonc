{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "housing-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "GOLD",
      "bucket_name": "housing-gold"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "housing-dashboard-db",
      "database_id": "da919269-6e2e-410d-b654-6c934ccb6226"
    }
  ]
}
